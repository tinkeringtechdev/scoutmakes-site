---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact" description="Get in touch with ScoutMakes / TinkeringTech.">
  <p class="eyebrow">Contact</p>
  <h1>Contact Us</h1>
  <p class="lede">
    Have a question about a ScoutMakes kit, a technical issue, or a distributor inquiry? Reach out directly:
  </p>
  <!-- TODO: replace with the address you want published, or swap this for a form endpoint
       (e.g. Formspree/Getform) if you'd rather not publish an email address directly. -->
  <p><a href="mailto:hello@scoutmakes.com">hello@scoutmakes.com</a></p>
  <p>
    You can also find design files and open an issue on
    <a href="https://github.com/tinkeringtech/scoutmakes">GitHub</a>.
  </p>
</BaseLayout>
